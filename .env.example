APP_NAME="AI Mock Interviewer API"
APP_ENV="development"
DEBUG=true
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

POSTGRES_DB=ai_interviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_interviewer

LOG_LEVEL=INFO
LOG_FORMAT=json

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
